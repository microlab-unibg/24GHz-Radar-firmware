 475:../Application/src/application.c **** /* This callback function will be executed by radar control at the end of data acquisition,
 476:../Application/src/application.c ****  * it is used to inform upper layers that data sampling is done and data is ready in user buffer
 477:../Application/src/application.c ****  */
 478:../Application/src/application.c **** void app_data_acq_done_cb(void *parameter)
 479:../Application/src/application.c **** {
 480:../Application/src/application.c **** 	/*bsp_led_red_off();
 481:../Application/src/application.c **** 	bsp_led_blue_off();
