 488:../Application/src/application.c **** 
 489:../Application/src/application.c **** void update_leds(algo_result_t *pResult)
 490:../Application/src/application.c **** {
 491:../Application/src/application.c **** 	if (pResult->target_approaching)
 492:../Application/src/application.c **** 	{
 493:../Application/src/application.c **** 		/*bsp_led_red_off();
 494:../Application/src/application.c **** 		bsp_led_blue_off();
 495:../Application/src/application.c **** 		bsp_led_green_on();*/
 496:../Application/src/application.c **** 
 497:../Application/src/application.c **** 		bsp_led_red_on();
 498:../Application/src/application.c **** 		bsp_led_blue_off();
 499:../Application/src/application.c **** 		bsp_led_green_off();
 500:../Application/src/application.c **** 
 501:../Application/src/application.c **** 		/* Arduino status IO */
 502:../Application/src/application.c **** 		DIGITAL_IO_SetOutputHigh(&DIGITAL_IO_ARD_D6);
 503:../Application/src/application.c **** 		DIGITAL_IO_SetOutputLow(&DIGITAL_IO_ARD_D4);
 504:../Application/src/application.c **** 		DIGITAL_IO_SetOutputLow(&DIGITAL_IO_ARD_D7);
 505:../Application/src/application.c **** 	}
 506:../Application/src/application.c **** 	else if (pResult->target_departing)
 507:../Application/src/application.c **** 	{
 508:../Application/src/application.c **** 		/*bsp_led_red_on();
 509:../Application/src/application.c **** 		bsp_led_blue_off();
 510:../Application/src/application.c **** 		bsp_led_green_off();*/
 511:../Application/src/application.c **** 
 512:../Application/src/application.c **** 		bsp_led_red_off();
 513:../Application/src/application.c **** 		bsp_led_blue_off();
 514:../Application/src/application.c **** 		bsp_led_green_on();
 515:../Application/src/application.c **** 
 516:../Application/src/application.c **** 		/* Arduino IO */
 517:../Application/src/application.c **** 		DIGITAL_IO_SetOutputHigh(&DIGITAL_IO_ARD_D7);
 518:../Application/src/application.c **** 		DIGITAL_IO_SetOutputLow(&DIGITAL_IO_ARD_D4);
 519:../Application/src/application.c **** 		DIGITAL_IO_SetOutputLow(&DIGITAL_IO_ARD_D6);
 520:../Application/src/application.c **** 	}
 521:../Application/src/application.c **** 	else if (pResult->motion_detected)
 522:../Application/src/application.c **** 	{
 523:../Application/src/application.c **** 		bsp_led_red_off();
 524:../Application/src/application.c **** 		bsp_led_blue_on();
 525:../Application/src/application.c **** 		bsp_led_green_off();
 526:../Application/src/application.c **** 
 527:../Application/src/application.c **** 		/* Arduino IO */
 528:../Application/src/application.c **** 		DIGITAL_IO_SetOutputHigh(&DIGITAL_IO_ARD_D4);
 529:../Application/src/application.c **** 		DIGITAL_IO_SetOutputLow(&DIGITAL_IO_ARD_D6);
 530:../Application/src/application.c **** 		DIGITAL_IO_SetOutputLow(&DIGITAL_IO_ARD_D7);
 531:../Application/src/application.c **** 	}
 532:../Application/src/application.c **** 	else
 533:../Application/src/application.c **** 	{
 534:../Application/src/application.c **** 		bsp_led_red_off();
 535:../Application/src/application.c **** 		bsp_led_blue_off();
 536:../Application/src/application.c **** 		bsp_led_green_off();
 537:../Application/src/application.c **** 
 538:../Application/src/application.c **** 		/* Arduino IO */
 539:../Application/src/application.c **** 		DIGITAL_IO_SetOutputLow(&DIGITAL_IO_ARD_D4);
 540:../Application/src/application.c **** 		DIGITAL_IO_SetOutputLow(&DIGITAL_IO_ARD_D6);
 541:../Application/src/application.c **** 		DIGITAL_IO_SetOutputLow(&DIGITAL_IO_ARD_D7);
 542:../Application/src/application.c **** 	}
 543:../Application/src/application.c **** }
