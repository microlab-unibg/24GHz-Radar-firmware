 322:../Application/src/application.c **** 
 323:../Application/src/application.c **** /* Main radar application process */
 324:../Application/src/application.c **** void radar_app_process(void)
 325:../Application/src/application.c **** {
 326:../Application/src/application.c **** 	if (acq_started)
 327:../Application/src/application.c **** 	{
 328:../Application/src/application.c **** 		/* ... */
 329:../Application/src/application.c **** 
 330:../Application/src/application.c **** 		acq_started = 0;
 331:../Application/src/application.c **** 		acq_completed_cb();
 332:../Application/src/application.c **** 	}
 333:../Application/src/application.c **** 
 334:../Application/src/application.c **** 	if (acq_completed)
 335:../Application/src/application.c **** 	{
 336:../Application/src/application.c **** 
 337:../Application/src/application.c **** #if defined(FMCW_SUPPORTED) || defined(DOPPLER_SUPPORTED)
 338:../Application/src/application.c **** 		/* Start the processing of the algorithm assigned in the function pointer 'algo_processor' */
 339:../Application/src/application.c **** 		if (algo_processing_function != NULL)
 340:../Application/src/application.c **** 		{
 341:../Application/src/application.c **** 			do_algo_helper();
 342:../Application/src/application.c **** 			algo_completed += 1;
 343:../Application/src/application.c **** 		}
 344:../Application/src/application.c **** #endif
 345:../Application/src/application.c **** 		acq_completed = 0;
 346:../Application/src/application.c **** 	}
 347:../Application/src/application.c **** 
 348:../Application/src/application.c **** 	if (algo_completed)
 349:../Application/src/application.c **** 	{
 350:../Application/src/application.c **** 		algo_completed_cb();
 351:../Application/src/application.c **** 		algo_completed = 0;
 352:../Application/src/application.c **** 	}
 353:../Application/src/application.c **** 
 354:../Application/src/application.c **** 	if (app_initalized)
 355:../Application/src/application.c **** 	{
 356:../Application/src/application.c **** 		switch (radar_app_state)
 357:../Application/src/application.c **** 		{
 358:../Application/src/application.c **** 		case APP_IDLE:
 359:../Application/src/application.c **** 			radar_app_state = APP_CHECK_FOR_SETTINGS_UPDATE;
 360:../Application/src/application.c **** 			break;
 361:../Application/src/application.c **** 
 362:../Application/src/application.c **** 		case APP_CHECK_FOR_SETTINGS_UPDATE:
 363:../Application/src/application.c **** 			/* Check if a new hardware settings are required */
 364:../Application/src/application.c **** 			if (ds_is_device_parameter_changed() || ds_is_device_settings_updated())
 365:../Application/src/application.c **** 			{
 366:../Application/src/application.c **** 				radar_app_state = APP_APPLY_DEVICE_SETTINGS;
 367:../Application/src/application.c **** 			}
 368:../Application/src/application.c **** 			else
 369:../Application/src/application.c **** 			{
 370:../Application/src/application.c **** 				radar_app_state = APP_CHECK_FOR_ERROR;
 371:../Application/src/application.c **** 			}
 372:../Application/src/application.c **** 			break;
 373:../Application/src/application.c **** 
 374:../Application/src/application.c **** 		case APP_APPLY_DEVICE_SETTINGS:
 375:../Application/src/application.c **** 			helper_do_hw_settings();
 376:../Application/src/application.c **** 			radar_app_state = APP_CHECK_FOR_ERROR;
 377:../Application/src/application.c **** 			break;
 378:../Application/src/application.c **** 
 379:../Application/src/application.c **** 		case APP_CHECK_FOR_ERROR:
 380:../Application/src/application.c **** 		{
 381:../Application/src/application.c **** 			int status = device_status_check();
 382:../Application/src/application.c **** 			if (status < 0)
 383:../Application/src/application.c **** 			{
 384:../Application/src/application.c **** 				radar_app_state = APP_HANDLE_ERROR;
 385:../Application/src/application.c **** 			}
 386:../Application/src/application.c **** 			else
 387:../Application/src/application.c **** 			{
 388:../Application/src/application.c **** 				radar_app_state = APP_IDLE;
 389:../Application/src/application.c **** 			}
 390:../Application/src/application.c **** 		}
 391:../Application/src/application.c **** 		break;
 392:../Application/src/application.c **** 
 393:../Application/src/application.c **** 		case APP_HANDLE_ERROR:
 394:../Application/src/application.c **** 			send_device_status_response();
 395:../Application/src/application.c **** 			radar_app_state = APP_IDLE;
 396:../Application/src/application.c **** 			break;
 397:../Application/src/application.c **** 
 398:../Application/src/application.c **** 		default:
 399:../Application/src/application.c **** 			break;
 400:../Application/src/application.c **** 		}
 401:../Application/src/application.c **** 	}
 402:../Application/src/application.c **** 	else
 403:../Application/src/application.c **** 	{
 404:../Application/src/application.c **** 		switch (radar_app_state)
 405:../Application/src/application.c **** 		{
 406:../Application/src/application.c **** 		case APP_IDLE:
 407:../Application/src/application.c **** 		case APP_CHECK_FOR_ERROR:
 408:../Application/src/application.c **** 		{
 409:../Application/src/application.c **** 			int status = device_status_check();
 410:../Application/src/application.c **** 			if (status < 0)
 411:../Application/src/application.c **** 			{
 412:../Application/src/application.c **** 				radar_app_state = APP_HANDLE_ERROR;
 413:../Application/src/application.c **** 			}
 414:../Application/src/application.c **** 			else
 415:../Application/src/application.c **** 			{
 416:../Application/src/application.c **** 				radar_app_state = APP_IDLE;
 417:../Application/src/application.c **** 			}
 418:../Application/src/application.c **** 		}
 419:../Application/src/application.c **** 		break;
 420:../Application/src/application.c **** 
 421:../Application/src/application.c **** 		case APP_HANDLE_ERROR:
 422:../Application/src/application.c **** 		{
 423:../Application/src/application.c **** 			/* Send out error only once, if PC app is not requesting it! */
 424:../Application/src/application.c **** 			if (!app_connected)
 425:../Application/src/application.c **** 			{
 426:../Application/src/application.c **** 
 427:../Application/src/application.c **** 				delayCount += 1;
 428:../Application/src/application.c **** 				if (delayCount == 100)
 429:../Application/src/application.c **** 				{
 430:../Application/src/application.c **** 					send_device_status_response();
 431:../Application/src/application.c **** 					app_connected = 1;
 432:../Application/src/application.c **** 					delayCount = 0;
 433:../Application/src/application.c **** 				}
 434:../Application/src/application.c **** 				bsp_time_delay(20, BSP_TIMER_DELAY_MILLISECOND);
 435:../Application/src/application.c **** 			}
 436:../Application/src/application.c **** 			radar_app_state = APP_CHECK_FOR_ERROR;
 437:../Application/src/application.c **** 		}
 438:../Application/src/application.c **** 		break;
 439:../Application/src/application.c **** 
 440:../Application/src/application.c **** 		default:
 441:../Application/src/application.c **** 			break;
 442:../Application/src/application.c **** 		}
 443:../Application/src/application.c **** 	}
 444:../Application/src/application.c **** }
