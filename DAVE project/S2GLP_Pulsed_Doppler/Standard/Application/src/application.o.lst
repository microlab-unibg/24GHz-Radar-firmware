 279:../Application/src/application.c **** 
 280:../Application/src/application.c **** static uint32_t helper_do_hw_settings(void)
 281:../Application/src/application.c **** {
 282:../Application/src/application.c **** 	device_settings_t *p_dev_settings = ds_device_get_settings();
 283:../Application/src/application.c **** 
 284:../Application/src/application.c **** 	uint32_t error = radar_apply_hw_settings(h_radar_device, p_dev_settings);
 285:../Application/src/application.c **** 	if (error == RADAR_ERR_OK)
 286:../Application/src/application.c **** 	{
 287:../Application/src/application.c **** 		ds_device_settings_copy_to_shadow();
 288:../Application/src/application.c **** 		/* add com-lib callback to send-out updated parameters!!! */
 289:../Application/src/application.c **** 	}
 290:../Application/src/application.c **** 	else
 291:../Application/src/application.c **** 	{
 292:../Application/src/application.c **** 		ds_device_settings_revert_from_shadow();
 293:../Application/src/application.c **** 		// current and new parameter differs, if an error occurred, tell to the application
 294:../Application/src/application.c **** 	}
 295:../Application/src/application.c **** 	radar_app_state = APP_IDLE;
 296:../Application/src/application.c **** 	ds_clear_device_parameter_changed();
 297:../Application/src/application.c **** 
 298:../Application/src/application.c **** 	error = radar_set_automatic_frame_trigger(h_radar_device, p_dev_settings->frame_period_usec);
 299:../Application/src/application.c **** 	return error;
 300:../Application/src/application.c **** }
