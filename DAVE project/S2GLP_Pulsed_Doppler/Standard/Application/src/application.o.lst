 257:../Application/src/application.c **** 
 258:../Application/src/application.c **** /* Main application process */
 259:../Application/src/application.c **** void app_process(void)
 260:../Application/src/application.c **** {
 261:../Application/src/application.c ****   if (g_usb_init == true)
 262:../Application/src/application.c ****   {
 263:../Application/src/application.c ****     /* Run communication protocol */
 264:../Application/src/application.c ****     protocol_run();
 265:../Application/src/application.c ****   }
 266:../Application/src/application.c ****   else
 267:../Application/src/application.c ****   {
 268:../Application/src/application.c ****     /* Initialize the USB low layer driver and start USB data communication */
 269:../Application/src/application.c ****     if (bsp_usb_init(BSP_USB_TIMEOUT) == 0)
 270:../Application/src/application.c ****     {
 271:../Application/src/application.c ****       g_usb_init = true;
 272:../Application/src/application.c ****     }
 273:../Application/src/application.c ****   }
 274:../Application/src/application.c ****   /* Main radar application process */
 275:../Application/src/application.c ****   radar_app_process();
 276:../Application/src/application.c **** }
