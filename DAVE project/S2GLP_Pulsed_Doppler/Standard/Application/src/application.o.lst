 183:../Application/src/application.c **** 
 184:../Application/src/application.c **** float calcCurrentConsumption_mA(device_settings_t *pDev)
 185:../Application/src/application.c **** {
 186:../Application/src/application.c **** 	float retval = 0.0F;
 187:../Application/src/application.c **** 	extern bool pwm_bgt_enabled;
 188:../Application/src/application.c **** 
 189:../Application/src/application.c **** 	if (!pwm_bgt_enabled)
 190:../Application/src/application.c **** 		return 0.0F; /* invalid! */
 191:../Application/src/application.c **** 
 192:../Application/src/application.c **** 	if (ds_get_board_variant() == 1)
 193:../Application/src/application.c **** 	{
 194:../Application/src/application.c **** 		float bgt_on_current_mA   = BSP_BGT_ON_CURRENT_mA;
 195:../Application/src/application.c **** 		float ptat_on_current_mA  = BSP_PTAT_ON_CURRENT_mA;
 196:../Application/src/application.c **** 		float bbf_on_current_mA   = BSP_BBF_ON_CURRENT_mA;
 197:../Application/src/application.c **** 
 198:../Application/src/application.c **** 		float f_sample            = (float)pDev->adc_sampling_freq_Hz;
 199:../Application/src/application.c **** 		float frame_period_sec    = (float)pDev->frame_period_usec / 1000000.0F;
 200:../Application/src/application.c **** 		float pulse_width_sec     = (float)pDev->pulse_width_usec / 1000000.0F;
 201:../Application/src/application.c **** 		float skipped_samples     = (float)pDev->num_sample_skip_count;
 202:../Application/src/application.c **** 		float samples             = (float)pDev->num_samples_per_chirp;
 203:../Application/src/application.c **** 		float ptat_delay_sec      = (float)pDev->ptat_delay_usec / 1000000.0F;
 204:../Application/src/application.c **** 
 205:../Application/src/application.c **** 		float total_samples       = (skipped_samples + samples);
 206:../Application/src/application.c **** 
 207:../Application/src/application.c **** 		float frame_on_time_sec   = (total_samples - 1) / f_sample + pulse_width_sec;
 208:../Application/src/application.c **** 		float bgt_on_time_sec     = total_samples * pulse_width_sec;
 209:../Application/src/application.c **** 		float ptat_on_time_sec    = frame_on_time_sec + ptat_delay_sec;
 210:../Application/src/application.c **** 		float bbf_on_time_sec     = frame_period_sec; // baseband filter is not switched, but always on!
 211:../Application/src/application.c **** 
 212:../Application/src/application.c **** 		float bgt_duty_cycle      = bgt_on_time_sec / frame_period_sec;
 213:../Application/src/application.c **** 		float ptat_duty_cycle     = ptat_on_time_sec / frame_period_sec;
 214:../Application/src/application.c **** 		float bbf_duty_cycle      = bbf_on_time_sec / frame_period_sec;
 215:../Application/src/application.c **** 
 216:../Application/src/application.c **** 		retval = (bgt_duty_cycle * bgt_on_current_mA) + (ptat_duty_cycle * ptat_on_current_mA) + (bbf_dut
 217:../Application/src/application.c **** 	}
 218:../Application/src/application.c **** 	else
 219:../Application/src/application.c **** 	{
 220:../Application/src/application.c **** 		float bgt_on_current_mA   = BSP_BGT_ON_CURRENT_mA;
 221:../Application/src/application.c **** 		float ptat_on_current_mA  = BSP_PTAT_ON_CURRENT_mA;
 222:../Application/src/application.c **** 		float bbf_on_current_mA   = BSP_BBF_ON_CURRENT_mA;
 223:../Application/src/application.c **** 
 224:../Application/src/application.c **** 		float f_sample            = (float)pDev->adc_sampling_freq_Hz;
 225:../Application/src/application.c **** 		float frame_period_sec    = (float)pDev->frame_period_usec / 1000000.0F;
 226:../Application/src/application.c **** 		float pulse_width_sec     = (float)pDev->pulse_width_usec / 1000000.0F;
 227:../Application/src/application.c **** 		float skipped_samples     = (float)pDev->num_sample_skip_count;
 228:../Application/src/application.c **** 		float samples             = (float)pDev->num_samples_per_chirp;
 229:../Application/src/application.c **** 		float ptat_delay_sec      = (float)pDev->ptat_delay_usec / 1000000.0F;
 230:../Application/src/application.c **** 		float ptat_pulse_time_sec = (float)PTAT_S_H_PULSE_WIDTH_USEC / 1000000.0F;
 231:../Application/src/application.c **** 		float bbf_advance_sec     = (float)BB_PRE_TRIGGER_ADVANCE_USEC / 1000000.0F;
 232:../Application/src/application.c **** 
 233:../Application/src/application.c **** 		float total_samples       = (skipped_samples + samples);
 234:../Application/src/application.c **** 
 235:../Application/src/application.c **** 		if (fabs(samples / f_sample - frame_period_sec) < 0.001F) // equidistant mode
 236:../Application/src/application.c **** 			ptat_delay_sec = 0.0F;
 237:../Application/src/application.c **** 
 238:../Application/src/application.c **** 		float bgt_on_time_sec     = total_samples * pulse_width_sec;
 239:../Application/src/application.c **** 		float ptat_on_time_sec    = total_samples * ptat_pulse_time_sec + ptat_delay_sec;
 240:../Application/src/application.c **** 
 241:../Application/src/application.c **** 		float DMA_TRANSFER_SEC    = 2.0F / 1000.0F;
 242:../Application/src/application.c **** 		float bbf_on_time_sec     = bbf_advance_sec + (samples - 1) / f_sample + DMA_TRANSFER_SEC; // bas
 243:../Application/src/application.c **** 		if (bbf_on_time_sec > frame_period_sec)
 244:../Application/src/application.c **** 			bbf_on_time_sec = frame_period_sec;
 245:../Application/src/application.c **** 
 246:../Application/src/application.c **** 		float bgt_duty_cycle  = bgt_on_time_sec / frame_period_sec;
 247:../Application/src/application.c **** 		float ptat_duty_cycle = ptat_on_time_sec / frame_period_sec;
 248:../Application/src/application.c **** 		float bbf_duty_cycle  = bbf_on_time_sec / frame_period_sec;
 249:../Application/src/application.c **** 
 250:../Application/src/application.c **** 		retval = (bgt_duty_cycle * bgt_on_current_mA) + (ptat_duty_cycle * ptat_on_current_mA) + (bbf_dut
 251:../Application/src/application.c **** 	}
 252:../Application/src/application.c **** 
 253:../Application/src/application.c **** 	return retval;
 254:../Application/src/application.c **** }
 255:../Application/src/application.c **** 
