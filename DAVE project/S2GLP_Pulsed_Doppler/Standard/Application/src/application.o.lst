 117:../Application/src/application.c **** /* Initialize all firmware and algorithm parameters and start communication protocol */
 118:../Application/src/application.c **** void app_init(void)
 119:../Application/src/application.c **** {
 120:../Application/src/application.c ****   /* Initialize USB */
 121:../Application/src/application.c ****   if (bsp_usb_init(BSP_USB_TIMEOUT) == 0)
 122:../Application/src/application.c ****   {
 123:../Application/src/application.c ****     g_usb_init = true;
 124:../Application/src/application.c ****   }
 125:../Application/src/application.c **** 
 126:../Application/src/application.c ****   /* Register all endpoints to the communication protocol */
 127:../Application/src/application.c ****   Endpoint_t ep_list[NUMBER_SUPPORTED_ENDPOINTS] =
 128:../Application/src/application.c ****   {
 129:../Application/src/application.c ****     EP_RADAR_MCUBASE_LIST_ENTRY(h_radar_device),
 130:../Application/src/application.c **** 	EP_RADAR_S2GLPULSE_LIST_ENTRY(h_radar_device),
 131:../Application/src/application.c ****   	EP_RADAR_DEVICE_STATUS_LIST_ENTRY(h_radar_device)
 132:../Application/src/application.c ****   };
 133:../Application/src/application.c **** 
 134:../Application/src/application.c ****   /* Register all endpoints in case of init error to the communication protocol */
 135:../Application/src/application.c ****   Endpoint_t ep_err_list[2] =
 136:../Application/src/application.c ****   {
 137:../Application/src/application.c ****     EP_RADAR_MCUBASE_LIST_ENTRY(h_radar_device),
 138:../Application/src/application.c ****   	EP_RADAR_DEVICE_STATUS_LIST_ENTRY(h_radar_device)
 139:../Application/src/application.c ****   };
 140:../Application/src/application.c **** 
 141:../Application/src/application.c ****   app_initalized = 0;
 142:../Application/src/application.c ****   uint8_t num_of_ep = sizeof(ep_err_list)/sizeof(ep_err_list[0]);
 143:../Application/src/application.c ****   Endpoint_t *pEndPoints = &ep_err_list[0];
 144:../Application/src/application.c **** 
 145:../Application/src/application.c ****   /* Open the available radar device */
 146:../Application/src/application.c ****   if (radar_open_device(0, &h_radar_device) == RADAR_ERR_OK)
 147:../Application/src/application.c ****   {
 148:../Application/src/application.c **** 	  app_initalized = 1;
 149:../Application/src/application.c **** 	  /* Register user callback functions */
 150:../Application/src/application.c **** 	  radar_register_callback(RADAR_ACQUISITION_STARTED_CB_ID, app_data_acq_started_cb);
 151:../Application/src/application.c **** 	  radar_register_callback(RADAR_ACQUISITION_DONE_CB_ID, app_data_acq_done_cb);
 152:../Application/src/application.c **** 
 153:../Application/src/application.c **** 	  num_of_ep = sizeof(ep_list)/sizeof(ep_list[0]);
 154:../Application/src/application.c **** 	  pEndPoints = &ep_list[0];
 155:../Application/src/application.c ****   }
 156:../Application/src/application.c ****   memcpy(endpoint_list, pEndPoints, num_of_ep * sizeof(Endpoint_t));
 157:../Application/src/application.c **** 
 158:../Application/src/application.c ****   /* Initialize the internal protocol state and the communication interface */
 159:../Application/src/application.c ****   protocol_init(endpoint_list, num_of_ep, NULL, BSP_HOST_TIMEOUT_USEC, system_reset);
 160:../Application/src/application.c **** 
 161:../Application/src/application.c ****   /* Initialize the internal protocol state and the communication interface */
 162:../Application/src/application.c ****   if (app_initalized)
 163:../Application/src/application.c ****   {
 164:../Application/src/application.c **** 	  /* Start data acquisition at the defined frame interval */
 165:../Application/src/application.c **** 	  if (radar_start_acquisition(h_radar_device) != RADAR_ERR_OK)
 166:../Application/src/application.c **** 	  {
 167:../Application/src/application.c **** 		XMC_DEBUG("Starting Radar data acquisition failed\n");
 168:../Application/src/application.c **** 		while (1U);
 169:../Application/src/application.c **** 	  }
 170:../Application/src/application.c ****   }
 171:../Application/src/application.c **** }
