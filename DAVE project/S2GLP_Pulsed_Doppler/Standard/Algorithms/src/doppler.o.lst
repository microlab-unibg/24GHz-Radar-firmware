  73:../Algorithms/src/doppler.c **** {
  74:../Algorithms/src/doppler.c **** 	//
  75:../Algorithms/src/doppler.c ****   .fft_window_type = FFT_WINDOW_CHEBYSHEV,       /* Type of window defined by \ref FFT_Window_Type_
  76:../Algorithms/src/doppler.c ****   .fft_size = FFT_SIZE_256,                      /* FFT size \ref FFT_Size_t  */
  77:../Algorithms/src/doppler.c ****   .fft_window_length = 0,                        /* Number of elements in the FFT window  */
  78:../Algorithms/src/doppler.c ****   //TODO: To be checked with CW the value of AT
  79:../Algorithms/src/doppler.c ****   .fft_chebyshev_at_dB = 60,                     /* Attenuation parameter needed in case of Chebysh
  80:../Algorithms/src/doppler.c ****   .fft_time_twiddle_table = NULL,                /* Pointer to twiddle factor table for FFT windowi
  81:../Algorithms/src/doppler.c ****   .fft_window_buffer = fft_fast_window_buffer    /* Pointer to floating point memory containing dat
  82:../Algorithms/src/doppler.c **** };
  83:../Algorithms/src/doppler.c **** 
