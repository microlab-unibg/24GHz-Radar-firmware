 132:../Algorithms/src/doppler.c **** void breathing_do(acq_buf_obj *p_acq_buf, const algo_settings_t *cp_algo_settings,
 133:../Algorithms/src/doppler.c ****                 const device_settings_t *cp_dev_settings, algo_result_t *p_algo_result)
 134:../Algorithms/src/doppler.c **** {
 135:../Algorithms/src/doppler.c ****     static float raw_data_i1[BSP_MAX_NUM_SAMPLES_PER_CHIRP];
 136:../Algorithms/src/doppler.c ****     static float raw_data_q1[BSP_MAX_NUM_SAMPLES_PER_CHIRP];
 137:../Algorithms/src/doppler.c ****     uint16_t *p_temp[BSP_NUM_OF_ADC_CHANNELS];
 138:../Algorithms/src/doppler.c ****     uint16_t Ns = p_acq_buf->params.num_of_samples_per_chirp;
 139:../Algorithms/src/doppler.c **** 
 140:../Algorithms/src/doppler.c ****     switch (state) {
 141:../Algorithms/src/doppler.c ****         case WAIT_BACKGROUND:
 142:../Algorithms/src/doppler.c ****             USBD_VCOM_SendString("\r\nPosizionarsi LONTANO dal radar.\r\n");
 143:../Algorithms/src/doppler.c ****             USBD_VCOM_SendString("Inizio acquisizione background tra 5 secondi...\r\n");
 144:../Algorithms/src/doppler.c ****             start_time = TIMER_GetTime(&TIMER_0);
 145:../Algorithms/src/doppler.c ****             while(TIMER_GetTime(&TIMER_0) - start_time < WAIT_TIME){
 146:../Algorithms/src/doppler.c ****             bsp_led_red_on();
 147:../Algorithms/src/doppler.c ****             bsp_led_blue_on();
 148:../Algorithms/src/doppler.c ****             bsp_led_green_off();
 149:../Algorithms/src/doppler.c ****             }
 150:../Algorithms/src/doppler.c ****             state = ACQUIRE_BACKGROUND;
 151:../Algorithms/src/doppler.c ****             break;
 152:../Algorithms/src/doppler.c **** 
 153:../Algorithms/src/doppler.c ****         case ACQUIRE_BACKGROUND:
 154:../Algorithms/src/doppler.c **** 
 155:../Algorithms/src/doppler.c ****         	bsp_led_red_off();
 156:../Algorithms/src/doppler.c ****         	bsp_led_blue_on();
 157:../Algorithms/src/doppler.c ****         	bsp_led_green_off();
 158:../Algorithms/src/doppler.c **** 
 159:../Algorithms/src/doppler.c ****             p_temp[0] = (uint16_t *)get_buffer_address_by_chirp(p_acq_buf, 2, 0);
 160:../Algorithms/src/doppler.c ****             p_temp[1] = (uint16_t *)get_buffer_address_by_chirp(p_acq_buf, 3, 0);
 161:../Algorithms/src/doppler.c **** 
 162:../Algorithms/src/doppler.c ****             for (uint32_t i = 0; i < FFT_SIZE; i++) {
 163:../Algorithms/src/doppler.c ****                 raw_data_i1[i] = (float)((p_temp[0])[i * DOWNSAMPLING_FACTOR]) * if_scale;
 164:../Algorithms/src/doppler.c ****                 raw_data_q1[i] = (float)((p_temp[1])[i * DOWNSAMPLING_FACTOR]) * if_scale;
 165:../Algorithms/src/doppler.c ****             }
 166:../Algorithms/src/doppler.c **** 
 167:../Algorithms/src/doppler.c ****             float complex_fft_signal[FFT_SIZE * 2] = {0};
 168:../Algorithms/src/doppler.c ****             float fft_result[FFT_SIZE / 2] = {0};
 169:../Algorithms/src/doppler.c **** 
 170:../Algorithms/src/doppler.c ****             compute_fft_signal(fft_fast_time_window, raw_data_i1, raw_data_q1, FFT_SIZE, FFT_SIZE, 
 171:../Algorithms/src/doppler.c ****                                FFT_INPUT_COMPLEX, NULL, NULL, complex_fft_signal);
 172:../Algorithms/src/doppler.c ****             compute_fft_spectrum(complex_fft_signal, FFT_SIZE, fft_result);
 173:../Algorithms/src/doppler.c **** 
 174:../Algorithms/src/doppler.c ****             for (int i = 0; i < FFT_SIZE / 2; i++) {
 175:../Algorithms/src/doppler.c ****                 background_fft[i] += fft_result[i] / BACKGROUND_FRAMES;
 176:../Algorithms/src/doppler.c ****             }
 177:../Algorithms/src/doppler.c **** 
 178:../Algorithms/src/doppler.c ****             frame_count++;
 179:../Algorithms/src/doppler.c ****             if (frame_count >= BACKGROUND_FRAMES) {
 180:../Algorithms/src/doppler.c ****                 USBD_VCOM_SendString("\r\nBackground acquisito.\r\n");
 181:../Algorithms/src/doppler.c ****                 USBD_VCOM_SendString("Posizionarsi DAVANTI al radar.\r\n");
 182:../Algorithms/src/doppler.c ****                 USBD_VCOM_SendString("Misurazione tra 5 secondi...\r\n");
 183:../Algorithms/src/doppler.c ****                 start_time = TIMER_GetTime(&TIMER_0);
 184:../Algorithms/src/doppler.c ****                 while(TIMER_GetTime(&TIMER_0) - start_time < WAIT_TIME){
 185:../Algorithms/src/doppler.c ****                 	bsp_led_red_off();
 186:../Algorithms/src/doppler.c ****                 	bsp_led_blue_on();
 187:../Algorithms/src/doppler.c ****                 	bsp_led_green_on();
 188:../Algorithms/src/doppler.c ****                 }
 189:../Algorithms/src/doppler.c ****             state = WAIT_PERSON;
 190:../Algorithms/src/doppler.c ****             }
 191:../Algorithms/src/doppler.c ****             break;
 192:../Algorithms/src/doppler.c **** 
 193:../Algorithms/src/doppler.c ****         case WAIT_PERSON:
 194:../Algorithms/src/doppler.c **** 
 195:../Algorithms/src/doppler.c ****         	bsp_led_red_off();
 196:../Algorithms/src/doppler.c ****         	bsp_led_blue_off();
 197:../Algorithms/src/doppler.c ****         	bsp_led_green_on();
 198:../Algorithms/src/doppler.c **** 
 199:../Algorithms/src/doppler.c ****             USBD_VCOM_SendString("Inizio misurazione respiro...\r\n");
 200:../Algorithms/src/doppler.c ****             state = MEASURE_BREATH;
 201:../Algorithms/src/doppler.c ****             break;
 202:../Algorithms/src/doppler.c **** 
 203:../Algorithms/src/doppler.c ****         case MEASURE_BREATH:
 204:../Algorithms/src/doppler.c ****             p_temp[0] = (uint16_t *)get_buffer_address_by_chirp(p_acq_buf, 2, 0);
 205:../Algorithms/src/doppler.c ****             p_temp[1] = (uint16_t *)get_buffer_address_by_chirp(p_acq_buf, 3, 0);
 206:../Algorithms/src/doppler.c **** 
 207:../Algorithms/src/doppler.c ****             for (uint32_t i = 0; i < FFT_SIZE; i++) {
 208:../Algorithms/src/doppler.c ****                 raw_data_i1[i] = (float)((p_temp[0])[i * DOWNSAMPLING_FACTOR]) * if_scale;
 209:../Algorithms/src/doppler.c ****                 raw_data_q1[i] = (float)((p_temp[1])[i * DOWNSAMPLING_FACTOR]) * if_scale;
 210:../Algorithms/src/doppler.c ****             }
 211:../Algorithms/src/doppler.c **** 
 212:../Algorithms/src/doppler.c ****             float complex_fft_signal2[FFT_SIZE * 2] = {0};
 213:../Algorithms/src/doppler.c ****             float fft_result2[FFT_SIZE / 2] = {0};
 214:../Algorithms/src/doppler.c ****             float clean_fft[FFT_SIZE / 2] = {0};
 215:../Algorithms/src/doppler.c **** 
 216:../Algorithms/src/doppler.c ****             compute_fft_signal(fft_fast_time_window, raw_data_i1, raw_data_q1, FFT_SIZE, FFT_SIZE, 
 217:../Algorithms/src/doppler.c ****                                FFT_INPUT_COMPLEX, NULL, NULL, complex_fft_signal2);
 218:../Algorithms/src/doppler.c ****             compute_fft_spectrum(complex_fft_signal2, FFT_SIZE, fft_result2);
 219:../Algorithms/src/doppler.c **** 
 220:../Algorithms/src/doppler.c ****             for (int i = 0; i < FFT_SIZE / 2; i++) {
 221:../Algorithms/src/doppler.c ****                 clean_fft[i] = fft_result2[i];//- background_fft[i];
 222:../Algorithms/src/doppler.c ****             }
 223:../Algorithms/src/doppler.c **** 
 224:../Algorithms/src/doppler.c ****             float max_amplitude = 0;
 225:../Algorithms/src/doppler.c ****             float breathing_frequency = 0;
 226:../Algorithms/src/doppler.c ****             for (int i = 1; i < FFT_SIZE / 2; i++) {
 227:../Algorithms/src/doppler.c ****                 float freq = (float)i / FFT_SIZE;
 228:../Algorithms/src/doppler.c ****                 if (freq > 0.1f && freq < 1.0f) {
 229:../Algorithms/src/doppler.c ****                     if (clean_fft[i] > max_amplitude) {
 230:../Algorithms/src/doppler.c ****                         max_amplitude = clean_fft[i];
 231:../Algorithms/src/doppler.c ****                         breathing_frequency = freq;
 232:../Algorithms/src/doppler.c ****                     }
 233:../Algorithms/src/doppler.c ****                 }
 234:../Algorithms/src/doppler.c ****             }
 235:../Algorithms/src/doppler.c **** 
 236:../Algorithms/src/doppler.c ****             float BRPM = breathing_frequency * 60;
 237:../Algorithms/src/doppler.c **** 
 238:../Algorithms/src/doppler.c ****             if (BRPM < 12) {
 239:../Algorithms/src/doppler.c ****                 bsp_led_blue_on();
 240:../Algorithms/src/doppler.c ****                 bsp_led_red_on();
 241:../Algorithms/src/doppler.c ****                 bsp_led_green_off();
 242:../Algorithms/src/doppler.c ****             } else if (BRPM > 16) {
 243:../Algorithms/src/doppler.c ****                 bsp_led_red_on();
 244:../Algorithms/src/doppler.c ****                 bsp_led_blue_off();
 245:../Algorithms/src/doppler.c ****                 bsp_led_green_off();
 246:../Algorithms/src/doppler.c ****             } else {
 247:../Algorithms/src/doppler.c ****                 bsp_led_green_on();
 248:../Algorithms/src/doppler.c ****                 bsp_led_red_off();
 249:../Algorithms/src/doppler.c ****                 bsp_led_blue_on();
 250:../Algorithms/src/doppler.c ****              }
 251:../Algorithms/src/doppler.c ****             break;
 252:../Algorithms/src/doppler.c ****     }
 253:../Algorithms/src/doppler.c **** }*/
 254:../Algorithms/src/doppler.c **** void breathing_do(acq_buf_obj *p_acq_buf, const algo_settings_t *cp_algo_settings, const device_set
 255:../Algorithms/src/doppler.c **** 
 256:../Algorithms/src/doppler.c ****     static float raw_data_i1[BSP_MAX_NUM_SAMPLES_PER_CHIRP];
 257:../Algorithms/src/doppler.c ****     static float raw_data_q1[BSP_MAX_NUM_SAMPLES_PER_CHIRP];
 258:../Algorithms/src/doppler.c **** 
 259:../Algorithms/src/doppler.c ****     uint16_t *p_temp[BSP_NUM_OF_ADC_CHANNELS];
 260:../Algorithms/src/doppler.c ****     uint16_t Ns = p_acq_buf->params.num_of_samples_per_chirp;
 261:../Algorithms/src/doppler.c **** 
 262:../Algorithms/src/doppler.c ****     /* Genera finestra FFT */
 263:../Algorithms/src/doppler.c ****     if (fft_fast_window_flag != Ns) {
 264:../Algorithms/src/doppler.c ****         fft_fast_time_window.fft_window_length = Ns;
 265:../Algorithms/src/doppler.c ****         if (fft_window_gen(&fft_fast_time_window) == 0) {
 266:../Algorithms/src/doppler.c ****             XMC_DEBUG("Errore generazione finestra FFT!\n");
 267:../Algorithms/src/doppler.c ****             while (1);
 268:../Algorithms/src/doppler.c ****         }
 269:../Algorithms/src/doppler.c ****         fft_fast_window_flag = Ns;
 270:../Algorithms/src/doppler.c ****     }
 271:../Algorithms/src/doppler.c **** 
 272:../Algorithms/src/doppler.c ****     /* Pulizia buffer */
 273:../Algorithms/src/doppler.c ****     memset(raw_data_i1, 0, sizeof(raw_data_i1));
 274:../Algorithms/src/doppler.c ****     memset(raw_data_q1, 0, sizeof(raw_data_q1));
 275:../Algorithms/src/doppler.c **** 
 276:../Algorithms/src/doppler.c ****     /* Acquisizione dati */
 277:../Algorithms/src/doppler.c ****     p_temp[0] = (uint16_t *)get_buffer_address_by_chirp(p_acq_buf, 0, 0);
 278:../Algorithms/src/doppler.c ****     p_temp[1] = (uint16_t *)get_buffer_address_by_chirp(p_acq_buf, 1, 0);
 279:../Algorithms/src/doppler.c **** 
 280:../Algorithms/src/doppler.c ****     for (uint32_t i = 0; i < Ns; i++) {
 281:../Algorithms/src/doppler.c ****         raw_data_i1[i] = (float)((p_temp[0])[i]) * if_scale;
 282:../Algorithms/src/doppler.c ****         raw_data_q1[i] = (float)((p_temp[1])[i]) * if_scale;
 283:../Algorithms/src/doppler.c ****     }
 284:../Algorithms/src/doppler.c **** 
 285:../Algorithms/src/doppler.c ****     /* Calcolo frequenza respiratoria */
 286:../Algorithms/src/doppler.c ****     breathing_calc_frequency(fft_fast_time_window, raw_data_i1, raw_data_q1, Ns, cp_algo_settings, 
 287:../Algorithms/src/doppler.c **** 
 288:../Algorithms/src/doppler.c ****     /* Salva frame corrente */
 289:../Algorithms/src/doppler.c ****     p_algo_result->frame_counter = p_acq_buf->frame_counter;
 290:../Algorithms/src/doppler.c **** }
