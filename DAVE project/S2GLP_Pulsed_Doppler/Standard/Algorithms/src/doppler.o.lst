 249:../Algorithms/src/doppler.c **** void doppler_do(acq_buf_obj *p_acq_buf, const algo_settings_t *cp_algo_settings,
 250:../Algorithms/src/doppler.c **** 				const device_settings_t *cp_dev_settings, algo_result_t *p_algo_result)
 251:../Algorithms/src/doppler.c **** {
 252:../Algorithms/src/doppler.c **** 	/* allocated as static memory, not on call stack */
 253:../Algorithms/src/doppler.c **** 	static float raw_data_i1[BSP_MAX_NUM_SAMPLES_PER_CHIRP];
 254:../Algorithms/src/doppler.c **** 	static float raw_data_q1[BSP_MAX_NUM_SAMPLES_PER_CHIRP];
 255:../Algorithms/src/doppler.c **** 
 256:../Algorithms/src/doppler.c **** 	uint16_t *p_temp[BSP_NUM_OF_ADC_CHANNELS];
 257:../Algorithms/src/doppler.c **** 	uint16_t Ns = p_acq_buf->params.num_of_samples_per_chirp;
 258:../Algorithms/src/doppler.c **** 
 259:../Algorithms/src/doppler.c **** 	/* Generate FFT window, it will be used for FFT calculation */
 260:../Algorithms/src/doppler.c **** 	if (fft_fast_window_flag != Ns)
 261:../Algorithms/src/doppler.c **** 	{
 262:../Algorithms/src/doppler.c **** 		fft_fast_time_window.fft_window_length = Ns; /* Number of elements in the FFT window  */
 263:../Algorithms/src/doppler.c **** 		if (fft_window_gen(&fft_fast_time_window) == 0)
 264:../Algorithms/src/doppler.c **** 		{
 265:../Algorithms/src/doppler.c **** 			XMC_DEBUG("Invalid FFT window parameters !\n");
 266:../Algorithms/src/doppler.c **** 			while (1);
 267:../Algorithms/src/doppler.c **** 		}
 268:../Algorithms/src/doppler.c **** 		fft_fast_window_flag = Ns;
 269:../Algorithms/src/doppler.c **** 	}
 270:../Algorithms/src/doppler.c **** 
 271:../Algorithms/src/doppler.c **** 	/* clear array values that are not acquired */
 272:../Algorithms/src/doppler.c **** 	memset(raw_data_i1, 0, sizeof(raw_data_i1));
 273:../Algorithms/src/doppler.c **** 	memset(raw_data_q1, 0, sizeof(raw_data_q1));
 274:../Algorithms/src/doppler.c **** 
 275:../Algorithms/src/doppler.c **** 	if (cp_algo_settings->use_high_gain_doppler)
 276:../Algorithms/src/doppler.c **** 	{
 277:../Algorithms/src/doppler.c **** 		/* Only one chirp for Doppler */
 278:../Algorithms/src/doppler.c **** 		p_temp[0] = (uint16_t *)get_buffer_address_by_chirp(p_acq_buf, 0, 0);
 279:../Algorithms/src/doppler.c **** 		p_temp[1] = (uint16_t *)get_buffer_address_by_chirp(p_acq_buf, 1, 0);
 280:../Algorithms/src/doppler.c **** 	}
 281:../Algorithms/src/doppler.c **** 	else
 282:../Algorithms/src/doppler.c **** 	{
 283:../Algorithms/src/doppler.c **** 		/* Only one chirp for Doppler */
 284:../Algorithms/src/doppler.c **** 		p_temp[0] = (uint16_t *)get_buffer_address_by_chirp(p_acq_buf, 2, 0);
 285:../Algorithms/src/doppler.c **** 		p_temp[1] = (uint16_t *)get_buffer_address_by_chirp(p_acq_buf, 3, 0);
 286:../Algorithms/src/doppler.c **** 	}
 287:../Algorithms/src/doppler.c **** 
 288:../Algorithms/src/doppler.c **** 	for (uint32_t i = 0; i < Ns; i++)
 289:../Algorithms/src/doppler.c **** 	{
 290:../Algorithms/src/doppler.c **** 		raw_data_i1[i] = (float)((p_temp[0])[i]) * if_scale;
 291:../Algorithms/src/doppler.c **** 		raw_data_q1[i] = (float)((p_temp[1])[i]) * if_scale;
 292:../Algorithms/src/doppler.c **** 	}
 293:../Algorithms/src/doppler.c **** 
 294:../Algorithms/src/doppler.c **** 	doppler_calc_speed(fft_fast_time_window, raw_data_i1, raw_data_q1, Ns, cp_algo_settings, cp_dev_se
 295:../Algorithms/src/doppler.c **** 
 296:../Algorithms/src/doppler.c **** 	/* indicated, that the results are taken from dedicated frame */
 297:../Algorithms/src/doppler.c **** 	p_algo_result->frame_counter = p_acq_buf->frame_counter;
 298:../Algorithms/src/doppler.c **** }
