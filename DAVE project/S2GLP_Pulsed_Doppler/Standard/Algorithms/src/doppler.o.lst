 347:../Algorithms/src/doppler.c ****     /* Definizione del range respiratorio tra 0.1 Hz e 1.0 Hz */
 348:../Algorithms/src/doppler.c ****     uint32_t fft_min_check = (uint32_t) ceilf(0.15f * downsampled_size / cp_dev_settings->adc_sampl
 349:../Algorithms/src/doppler.c ****     uint32_t fft_max_check = (uint32_t) ceilf(0.6f * downsampled_size / cp_dev_settings->adc_sampli
 350:../Algorithms/src/doppler.c ****     uint32_t size_check = fft_max_check - fft_min_check + 1;
 351:../Algorithms/src/doppler.c **** 
 352:../Algorithms/src/doppler.c ****     /* Trovo la frequenza dominante */
 353:../Algorithms/src/doppler.c ****     uint32_t maxBin = 0;
 354:../Algorithms/src/doppler.c ****     float maxVal = 0;
 355:../Algorithms/src/doppler.c ****     arm_max_f32(&clean_spectrum[fft_min_check], size_check, &maxVal, &maxBin);
 356:../Algorithms/src/doppler.c ****     maxBin += fft_min_check;
 357:../Algorithms/src/doppler.c **** 
 358:../Algorithms/src/doppler.c ****     float freq_per_bin = cp_dev_settings->adc_sampling_freq_Hz / (float)downsampled_size;
 359:../Algorithms/src/doppler.c ****     float breathing_frequency = maxBin * freq_per_bin;
 360:../Algorithms/src/doppler.c ****     float breathing_rate = breathing_frequency * 60.0f;  // Conversione in respiri al minuto
 361:../Algorithms/src/doppler.c **** 
 362:../Algorithms/src/doppler.c ****     /* Debug */
 363:../Algorithms/src/doppler.c ****     printf("DEBUG: maxBin=%u, breathing_frequency=%.2f Hz, BRPM=%.2f\n", maxBin, breathing_frequenc
 364:../Algorithms/src/doppler.c **** 
 365:../Algorithms/src/doppler.c ****     /* Classificazione del respiro */
 366:../Algorithms/src/doppler.c ****     if (breathing_rate < 12.0f) {  // Respirazione bassa
 367:../Algorithms/src/doppler.c ****         p_algo_result->motion_detected = 1;
 368:../Algorithms/src/doppler.c ****         bsp_led_blue_on();
 369:../Algorithms/src/doppler.c ****         bsp_led_red_on();
 370:../Algorithms/src/doppler.c ****         bsp_led_green_on();
 371:../Algorithms/src/doppler.c ****     }
 372:../Algorithms/src/doppler.c ****     else if (breathing_rate > 16.0f) {  // Respirazione alta
 373:../Algorithms/src/doppler.c ****         p_algo_result->target_approaching = 1;
 374:../Algorithms/src/doppler.c ****         bsp_led_red_on();
 375:../Algorithms/src/doppler.c ****         bsp_led_blue_on();
 376:../Algorithms/src/doppler.c ****         bsp_led_green_off();
 377:../Algorithms/src/doppler.c ****     }
 378:../Algorithms/src/doppler.c ****     else {  // Respirazione normale
 379:../Algorithms/src/doppler.c ****         p_algo_result->target_departing = 1;
 380:../Algorithms/src/doppler.c ****         bsp_led_green_on();
 381:../Algorithms/src/doppler.c ****         bsp_led_red_off();
 382:../Algorithms/src/doppler.c ****         bsp_led_blue_on();
 383:../Algorithms/src/doppler.c ****     }
 384:../Algorithms/src/doppler.c **** 
 385:../Algorithms/src/doppler.c ****     /* Salva i risultati */
