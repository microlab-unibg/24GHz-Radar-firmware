 131:../Algorithms/src/doppler.c **** void breathing_do(acq_buf_obj *p_acq_buf, const algo_settings_t *cp_algo_settings,
 132:../Algorithms/src/doppler.c ****                 const device_settings_t *cp_dev_settings, algo_result_t *p_algo_result)
 133:../Algorithms/src/doppler.c **** {
 134:../Algorithms/src/doppler.c ****     static float raw_data_i1[BSP_MAX_NUM_SAMPLES_PER_CHIRP];
 135:../Algorithms/src/doppler.c ****     static float raw_data_q1[BSP_MAX_NUM_SAMPLES_PER_CHIRP];
