  74:../Algorithms/src/doppler.c ****   //TODO: To be checked with CW the value of AT
  75:../Algorithms/src/doppler.c ****   .fft_chebyshev_at_dB = 60,                     /* Attenuation parameter needed in case of Chebysh
  76:../Algorithms/src/doppler.c ****   .fft_time_twiddle_table = NULL,                /* Pointer to twiddle factor table for FFT windowi
  77:../Algorithms/src/doppler.c ****   .fft_window_buffer = fft_fast_window_buffer    /* Pointer to floating point memory containing dat
  78:../Algorithms/src/doppler.c **** };
