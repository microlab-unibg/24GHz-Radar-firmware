  79:../Algorithms/src/doppler.c ****   .fft_time_twiddle_table = NULL,                /* Pointer to twiddle factor table for FFT windowi
  80:../Algorithms/src/doppler.c ****   .fft_window_buffer = fft_fast_window_buffer    /* Pointer to floating point memory containing dat
  81:../Algorithms/src/doppler.c **** };
