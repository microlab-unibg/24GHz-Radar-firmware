  59:../Algorithms/src/doppler.c **** /* Allocate in static memory, the pointer is used in results passed to application */
  60:../Algorithms/src/doppler.c **** /* 2 time FFT_SIZE elements is needed, because we first calculate the complex spectrum */
  61:../Algorithms/src/doppler.c **** static float   doppler_spectrum[2*FFT_SIZE];
  62:../Algorithms/src/doppler.c **** static float*  doppler_fft_signal = doppler_spectrum;
  63:../Algorithms/src/doppler.c **** 
  64:../Algorithms/src/doppler.c **** static float   breathing_spectrum[2*FFT_SIZE];
  65:../Algorithms/src/doppler.c **** static float*  breathing_fft_signal = doppler_spectrum;
  66:../Algorithms/src/doppler.c **** 
  67:../Algorithms/src/doppler.c **** static float   if_scale = (float)DOPPLER_IQ_SCALE * 3.3f / 4095.0f;
  68:../Algorithms/src/doppler.c **** 
  69:../Algorithms/src/doppler.c **** /* FFT window */
  70:../Algorithms/src/doppler.c **** static float   fft_fast_window_buffer[FFT_SIZE];
  71:../Algorithms/src/doppler.c **** static uint32_t fft_fast_window_flag = 0;
