 352:../Algorithms/src/doppler.c **** 
 353:../Algorithms/src/doppler.c **** void doppler_do(acq_buf_obj *p_acq_buf, const algo_settings_t *cp_algo_settings,
 354:../Algorithms/src/doppler.c **** 				const device_settings_t *cp_dev_settings, algo_result_t *p_algo_result)
 355:../Algorithms/src/doppler.c **** {
 356:../Algorithms/src/doppler.c **** 	/* allocated as static memory, not on call stack */
 357:../Algorithms/src/doppler.c **** 	static float raw_data_i1[BSP_MAX_NUM_SAMPLES_PER_CHIRP];
 358:../Algorithms/src/doppler.c **** 	static float raw_data_q1[BSP_MAX_NUM_SAMPLES_PER_CHIRP];
 359:../Algorithms/src/doppler.c **** 
 360:../Algorithms/src/doppler.c **** 	uint16_t *p_temp[BSP_NUM_OF_ADC_CHANNELS];
 361:../Algorithms/src/doppler.c **** 	uint16_t Ns = p_acq_buf->params.num_of_samples_per_chirp;
 362:../Algorithms/src/doppler.c **** 
 363:../Algorithms/src/doppler.c **** 	/* Generate FFT window, it will be used for FFT calculation */
 364:../Algorithms/src/doppler.c **** 	if (fft_fast_window_flag != Ns)
 365:../Algorithms/src/doppler.c **** 	{
 366:../Algorithms/src/doppler.c **** 		fft_fast_time_window.fft_window_length = Ns; /* Number of elements in the FFT window  */
 367:../Algorithms/src/doppler.c **** 		if (fft_window_gen(&fft_fast_time_window) == 0)
 368:../Algorithms/src/doppler.c **** 		{
 369:../Algorithms/src/doppler.c **** 			XMC_DEBUG("Invalid FFT window parameters !\n");
 370:../Algorithms/src/doppler.c **** 			while (1);
 371:../Algorithms/src/doppler.c **** 		}
 372:../Algorithms/src/doppler.c **** 		fft_fast_window_flag = Ns;
 373:../Algorithms/src/doppler.c **** 	}
 374:../Algorithms/src/doppler.c **** 
 375:../Algorithms/src/doppler.c **** 	/* clear array values that are not acquired */
 376:../Algorithms/src/doppler.c **** 	memset(raw_data_i1, 0, sizeof(raw_data_i1));
 377:../Algorithms/src/doppler.c **** 	memset(raw_data_q1, 0, sizeof(raw_data_q1));
 378:../Algorithms/src/doppler.c **** 
 379:../Algorithms/src/doppler.c **** 	if (cp_algo_settings->use_high_gain_doppler)
 380:../Algorithms/src/doppler.c **** 	{
 381:../Algorithms/src/doppler.c **** 		/* Only one chirp for Doppler */
 382:../Algorithms/src/doppler.c **** 		p_temp[0] = (uint16_t *)get_buffer_address_by_chirp(p_acq_buf, 0, 0);
 383:../Algorithms/src/doppler.c **** 		p_temp[1] = (uint16_t *)get_buffer_address_by_chirp(p_acq_buf, 1, 0);
 384:../Algorithms/src/doppler.c **** 	}
 385:../Algorithms/src/doppler.c **** 	else
 386:../Algorithms/src/doppler.c **** 	{
 387:../Algorithms/src/doppler.c **** 		/* Only one chirp for Doppler */
 388:../Algorithms/src/doppler.c **** 		p_temp[0] = (uint16_t *)get_buffer_address_by_chirp(p_acq_buf, 2, 0);
 389:../Algorithms/src/doppler.c **** 		p_temp[1] = (uint16_t *)get_buffer_address_by_chirp(p_acq_buf, 3, 0);
 390:../Algorithms/src/doppler.c **** 	}
 391:../Algorithms/src/doppler.c **** 
 392:../Algorithms/src/doppler.c **** 	for (uint32_t i = 0; i < Ns; i++)
 393:../Algorithms/src/doppler.c **** 	{
 394:../Algorithms/src/doppler.c **** 		raw_data_i1[i] = (float)((p_temp[0])[i]) * if_scale;
 395:../Algorithms/src/doppler.c **** 		raw_data_q1[i] = (float)((p_temp[1])[i]) * if_scale;
 396:../Algorithms/src/doppler.c **** 	}
 397:../Algorithms/src/doppler.c **** 
 398:../Algorithms/src/doppler.c **** 	doppler_calc_speed(fft_fast_time_window, raw_data_i1, raw_data_q1, Ns, cp_algo_settings, cp_dev_se
 399:../Algorithms/src/doppler.c **** 
 400:../Algorithms/src/doppler.c **** 	/* indicated, that the results are taken from dedicated frame */
 401:../Algorithms/src/doppler.c **** 	p_algo_result->frame_counter = p_acq_buf->frame_counter;
 402:../Algorithms/src/doppler.c **** }
