 138:../Algorithms/src/doppler.c **** 
 139:../Algorithms/src/doppler.c ****     switch (state) {
 140:../Algorithms/src/doppler.c ****         case WAIT_BACKGROUND:
 141:../Algorithms/src/doppler.c ****             USBD_VCOM_SendString("\r\nPosizionarsi LONTANO dal radar.\r\n");
 142:../Algorithms/src/doppler.c ****             USBD_VCOM_SendString("Inizio acquisizione background tra 5 secondi...\r\n");
 143:../Algorithms/src/doppler.c ****             start_time = TIMER_GetTime(&TIMER_0);
 144:../Algorithms/src/doppler.c ****             while(TIMER_GetTime(&TIMER_0) - start_time < WAIT_TIME){
 145:../Algorithms/src/doppler.c ****             bsp_led_red_on();
 146:../Algorithms/src/doppler.c ****             bsp_led_blue_on();
 147:../Algorithms/src/doppler.c ****             bsp_led_green_off();
 148:../Algorithms/src/doppler.c ****             }
 149:../Algorithms/src/doppler.c ****             state = ACQUIRE_BACKGROUND;
 150:../Algorithms/src/doppler.c ****             break;
 151:../Algorithms/src/doppler.c **** 
 152:../Algorithms/src/doppler.c ****         case ACQUIRE_BACKGROUND:
 153:../Algorithms/src/doppler.c **** 
 154:../Algorithms/src/doppler.c ****         	bsp_led_red_off();
 155:../Algorithms/src/doppler.c ****         	bsp_led_blue_on();
 156:../Algorithms/src/doppler.c ****         	bsp_led_green_off();
 157:../Algorithms/src/doppler.c **** 
 158:../Algorithms/src/doppler.c ****             p_temp[0] = (uint16_t *)get_buffer_address_by_chirp(p_acq_buf, 2, 0);
 159:../Algorithms/src/doppler.c ****             p_temp[1] = (uint16_t *)get_buffer_address_by_chirp(p_acq_buf, 3, 0);
 160:../Algorithms/src/doppler.c **** 
 161:../Algorithms/src/doppler.c ****             for (uint32_t i = 0; i < FFT_SIZE; i++) {
 162:../Algorithms/src/doppler.c ****                 raw_data_i1[i] = (float)((p_temp[0])[i * DOWNSAMPLING_FACTOR]) * if_scale;
 163:../Algorithms/src/doppler.c ****                 raw_data_q1[i] = (float)((p_temp[1])[i * DOWNSAMPLING_FACTOR]) * if_scale;
 164:../Algorithms/src/doppler.c ****             }
 165:../Algorithms/src/doppler.c **** 
 166:../Algorithms/src/doppler.c ****             float complex_fft_signal[FFT_SIZE * 2] = {0};
 167:../Algorithms/src/doppler.c ****             float fft_result[FFT_SIZE / 2] = {0};
 168:../Algorithms/src/doppler.c **** 
 169:../Algorithms/src/doppler.c ****             compute_fft_signal(fft_fast_time_window, raw_data_i1, raw_data_q1, FFT_SIZE, FFT_SIZE, 
 170:../Algorithms/src/doppler.c ****                                FFT_INPUT_COMPLEX, NULL, NULL, complex_fft_signal);
 171:../Algorithms/src/doppler.c ****             compute_fft_spectrum(complex_fft_signal, FFT_SIZE, fft_result);
 172:../Algorithms/src/doppler.c **** 
 173:../Algorithms/src/doppler.c ****             for (int i = 0; i < FFT_SIZE / 2; i++) {
 174:../Algorithms/src/doppler.c ****                 background_fft[i] += fft_result[i] / BACKGROUND_FRAMES;
 175:../Algorithms/src/doppler.c ****             }
 176:../Algorithms/src/doppler.c **** 
 177:../Algorithms/src/doppler.c ****             frame_count++;
 178:../Algorithms/src/doppler.c ****             if (frame_count >= BACKGROUND_FRAMES) {
 179:../Algorithms/src/doppler.c ****                 USBD_VCOM_SendString("\r\nBackground acquisito.\r\n");
 180:../Algorithms/src/doppler.c ****                 USBD_VCOM_SendString("Posizionarsi DAVANTI al radar.\r\n");
 181:../Algorithms/src/doppler.c ****                 USBD_VCOM_SendString("Misurazione tra 5 secondi...\r\n");
 182:../Algorithms/src/doppler.c ****                 start_time = TIMER_GetTime(&TIMER_0);
 183:../Algorithms/src/doppler.c ****                 while(TIMER_GetTime(&TIMER_0) - start_time < WAIT_TIME){
 184:../Algorithms/src/doppler.c ****                 	bsp_led_red_off();
 185:../Algorithms/src/doppler.c ****                 	bsp_led_blue_on();
 186:../Algorithms/src/doppler.c ****                 	bsp_led_green_on();
 187:../Algorithms/src/doppler.c ****                 }
 188:../Algorithms/src/doppler.c ****             state = WAIT_PERSON;
 189:../Algorithms/src/doppler.c ****             }
 190:../Algorithms/src/doppler.c ****             break;
 191:../Algorithms/src/doppler.c **** 
 192:../Algorithms/src/doppler.c ****         case WAIT_PERSON:
 193:../Algorithms/src/doppler.c **** 
 194:../Algorithms/src/doppler.c ****         	bsp_led_red_off();
 195:../Algorithms/src/doppler.c ****         	bsp_led_blue_off();
 196:../Algorithms/src/doppler.c ****         	bsp_led_green_on();
 197:../Algorithms/src/doppler.c **** 
 198:../Algorithms/src/doppler.c ****             USBD_VCOM_SendString("Inizio misurazione respiro...\r\n");
 199:../Algorithms/src/doppler.c ****             state = MEASURE_BREATH;
 200:../Algorithms/src/doppler.c ****             break;
 201:../Algorithms/src/doppler.c **** 
 202:../Algorithms/src/doppler.c ****         case MEASURE_BREATH:
 203:../Algorithms/src/doppler.c ****             p_temp[0] = (uint16_t *)get_buffer_address_by_chirp(p_acq_buf, 2, 0);
 204:../Algorithms/src/doppler.c ****             p_temp[1] = (uint16_t *)get_buffer_address_by_chirp(p_acq_buf, 3, 0);
 205:../Algorithms/src/doppler.c **** 
 206:../Algorithms/src/doppler.c ****             for (uint32_t i = 0; i < FFT_SIZE; i++) {
 207:../Algorithms/src/doppler.c ****                 raw_data_i1[i] = (float)((p_temp[0])[i * DOWNSAMPLING_FACTOR]) * if_scale;
 208:../Algorithms/src/doppler.c ****                 raw_data_q1[i] = (float)((p_temp[1])[i * DOWNSAMPLING_FACTOR]) * if_scale;
 209:../Algorithms/src/doppler.c ****             }
 210:../Algorithms/src/doppler.c **** 
 211:../Algorithms/src/doppler.c ****             float complex_fft_signal2[FFT_SIZE * 2] = {0};
 212:../Algorithms/src/doppler.c ****             float fft_result2[FFT_SIZE / 2] = {0};
 213:../Algorithms/src/doppler.c ****             float clean_fft[FFT_SIZE / 2] = {0};
 214:../Algorithms/src/doppler.c **** 
 215:../Algorithms/src/doppler.c ****             compute_fft_signal(fft_fast_time_window, raw_data_i1, raw_data_q1, FFT_SIZE, FFT_SIZE, 
 216:../Algorithms/src/doppler.c ****                                FFT_INPUT_COMPLEX, NULL, NULL, complex_fft_signal2);
 217:../Algorithms/src/doppler.c ****             compute_fft_spectrum(complex_fft_signal2, FFT_SIZE, fft_result2);
 218:../Algorithms/src/doppler.c **** 
 219:../Algorithms/src/doppler.c ****             for (int i = 0; i < FFT_SIZE / 2; i++) {
 220:../Algorithms/src/doppler.c ****                 clean_fft[i] = fft_result2[i];//- background_fft[i];
 221:../Algorithms/src/doppler.c ****             }
 222:../Algorithms/src/doppler.c **** 
 223:../Algorithms/src/doppler.c ****             float max_amplitude = 0;
 224:../Algorithms/src/doppler.c ****             float breathing_frequency = 0;
 225:../Algorithms/src/doppler.c ****             for (int i = 1; i < FFT_SIZE / 2; i++) {
 226:../Algorithms/src/doppler.c ****                 float freq = (float)i / FFT_SIZE;
 227:../Algorithms/src/doppler.c ****                 if (freq > 0.1f && freq < 1.0f) {
 228:../Algorithms/src/doppler.c ****                     if (clean_fft[i] > max_amplitude) {
 229:../Algorithms/src/doppler.c ****                         max_amplitude = clean_fft[i];
 230:../Algorithms/src/doppler.c ****                         breathing_frequency = freq;
 231:../Algorithms/src/doppler.c ****                     }
 232:../Algorithms/src/doppler.c ****                 }
 233:../Algorithms/src/doppler.c ****             }
 234:../Algorithms/src/doppler.c **** 
 235:../Algorithms/src/doppler.c ****             float BRPM = breathing_frequency * 60;
 236:../Algorithms/src/doppler.c **** 
 237:../Algorithms/src/doppler.c ****             if (BRPM < 12) {
 238:../Algorithms/src/doppler.c ****                 bsp_led_blue_on();
 239:../Algorithms/src/doppler.c ****                 bsp_led_red_on();
 240:../Algorithms/src/doppler.c ****                 bsp_led_green_off();
 241:../Algorithms/src/doppler.c ****             } else if (BRPM > 16) {
 242:../Algorithms/src/doppler.c ****                 bsp_led_red_on();
 243:../Algorithms/src/doppler.c ****                 bsp_led_blue_off();
 244:../Algorithms/src/doppler.c ****                 bsp_led_green_off();
 245:../Algorithms/src/doppler.c ****             } else {
 246:../Algorithms/src/doppler.c ****                 bsp_led_green_on();
 247:../Algorithms/src/doppler.c ****                 bsp_led_red_off();
 248:../Algorithms/src/doppler.c ****                 bsp_led_blue_on();
 249:../Algorithms/src/doppler.c ****              }
 250:../Algorithms/src/doppler.c ****             break;
 251:../Algorithms/src/doppler.c ****     }
 252:../Algorithms/src/doppler.c **** }*/
 253:../Algorithms/src/doppler.c **** void breathing_do(acq_buf_obj *p_acq_buf, const algo_settings_t *cp_algo_settings, const device_set
 254:../Algorithms/src/doppler.c **** 
 255:../Algorithms/src/doppler.c ****     static float raw_data_i1[BSP_MAX_NUM_SAMPLES_PER_CHIRP];
 256:../Algorithms/src/doppler.c ****     static float raw_data_q1[BSP_MAX_NUM_SAMPLES_PER_CHIRP];
 257:../Algorithms/src/doppler.c **** 
 258:../Algorithms/src/doppler.c ****     uint16_t *p_temp[BSP_NUM_OF_ADC_CHANNELS];
 259:../Algorithms/src/doppler.c ****     uint16_t Ns = p_acq_buf->params.num_of_samples_per_chirp;
 260:../Algorithms/src/doppler.c **** 
 261:../Algorithms/src/doppler.c ****     /* Genera la finestra FFT se necessario */
 262:../Algorithms/src/doppler.c ****     if (fft_fast_window_flag != Ns) {
 263:../Algorithms/src/doppler.c ****         fft_fast_time_window.fft_window_length = Ns;
 264:../Algorithms/src/doppler.c ****         if (fft_window_gen(&fft_fast_time_window) == 0) {
 265:../Algorithms/src/doppler.c ****             XMC_DEBUG("Errore generazione finestra FFT!\n");
 266:../Algorithms/src/doppler.c ****             while (1);
 267:../Algorithms/src/doppler.c ****         }
 268:../Algorithms/src/doppler.c ****         fft_fast_window_flag = Ns;
 269:../Algorithms/src/doppler.c ****     }
 270:../Algorithms/src/doppler.c **** 
 271:../Algorithms/src/doppler.c ****     /* Pulizia buffer */
 272:../Algorithms/src/doppler.c ****     memset(raw_data_i1, 0, sizeof(raw_data_i1));
 273:../Algorithms/src/doppler.c ****     memset(raw_data_q1, 0, sizeof(raw_data_q1));
 274:../Algorithms/src/doppler.c **** 
 275:../Algorithms/src/doppler.c ****     /* Acquisizione dati */
 276:../Algorithms/src/doppler.c ****     p_temp[0] = (uint16_t *)get_buffer_address_by_chirp(p_acq_buf, 0, 0);
 277:../Algorithms/src/doppler.c ****     p_temp[1] = (uint16_t *)get_buffer_address_by_chirp(p_acq_buf, 1, 0);
 278:../Algorithms/src/doppler.c **** 
 279:../Algorithms/src/doppler.c ****     for (uint32_t i = 0; i < Ns; i++) {
 280:../Algorithms/src/doppler.c ****         raw_data_i1[i] = (float)((p_temp[0])[i]) * if_scale;
 281:../Algorithms/src/doppler.c ****         raw_data_q1[i] = (float)((p_temp[1])[i]) * if_scale;
 282:../Algorithms/src/doppler.c ****     }
 283:../Algorithms/src/doppler.c **** 
 284:../Algorithms/src/doppler.c ****     /* Calcola la frequenza respiratoria */
 285:../Algorithms/src/doppler.c ****     breathing_calc_frequency(fft_fast_time_window, raw_data_i1, raw_data_q1, Ns, cp_algo_settings, 
 286:../Algorithms/src/doppler.c **** 
 287:../Algorithms/src/doppler.c ****     /* Salva il frame corrente */
 288:../Algorithms/src/doppler.c ****     p_algo_result->frame_counter = p_acq_buf->frame_counter;
 289:../Algorithms/src/doppler.c **** }
