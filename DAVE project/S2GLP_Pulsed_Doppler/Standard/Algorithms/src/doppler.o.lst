 390:../Algorithms/src/doppler.c **** 
 391:../Algorithms/src/doppler.c **** void doppler_do(acq_buf_obj *p_acq_buf, const algo_settings_t *cp_algo_settings,
 392:../Algorithms/src/doppler.c **** 				const device_settings_t *cp_dev_settings, algo_result_t *p_algo_result)
 393:../Algorithms/src/doppler.c **** {
 394:../Algorithms/src/doppler.c **** 	/* allocated as static memory, not on call stack */
 395:../Algorithms/src/doppler.c **** 	static float raw_data_i1[BSP_MAX_NUM_SAMPLES_PER_CHIRP];
 396:../Algorithms/src/doppler.c **** 	static float raw_data_q1[BSP_MAX_NUM_SAMPLES_PER_CHIRP];
 397:../Algorithms/src/doppler.c **** 
 398:../Algorithms/src/doppler.c **** 	uint16_t *p_temp[BSP_NUM_OF_ADC_CHANNELS];
 399:../Algorithms/src/doppler.c **** 	uint16_t Ns = p_acq_buf->params.num_of_samples_per_chirp;
 400:../Algorithms/src/doppler.c **** 
 401:../Algorithms/src/doppler.c **** 	/* Generate FFT window, it will be used for FFT calculation */
 402:../Algorithms/src/doppler.c **** 	if (fft_fast_window_flag != Ns)
 403:../Algorithms/src/doppler.c **** 	{
 404:../Algorithms/src/doppler.c **** 		fft_fast_time_window.fft_window_length = Ns; /* Number of elements in the FFT window  */
 405:../Algorithms/src/doppler.c **** 		if (fft_window_gen(&fft_fast_time_window) == 0)
 406:../Algorithms/src/doppler.c **** 		{
 407:../Algorithms/src/doppler.c **** 			XMC_DEBUG("Invalid FFT window parameters !\n");
 408:../Algorithms/src/doppler.c **** 			while (1);
 409:../Algorithms/src/doppler.c **** 		}
 410:../Algorithms/src/doppler.c **** 		fft_fast_window_flag = Ns;
 411:../Algorithms/src/doppler.c **** 	}
 412:../Algorithms/src/doppler.c **** 
 413:../Algorithms/src/doppler.c **** 	/* clear array values that are not acquired */
 414:../Algorithms/src/doppler.c **** 	memset(raw_data_i1, 0, sizeof(raw_data_i1));
 415:../Algorithms/src/doppler.c **** 	memset(raw_data_q1, 0, sizeof(raw_data_q1));
 416:../Algorithms/src/doppler.c **** 
 417:../Algorithms/src/doppler.c **** 	if (cp_algo_settings->use_high_gain_doppler)
 418:../Algorithms/src/doppler.c **** 	{
 419:../Algorithms/src/doppler.c **** 		/* Only one chirp for Doppler */
 420:../Algorithms/src/doppler.c **** 		p_temp[0] = (uint16_t *)get_buffer_address_by_chirp(p_acq_buf, 0, 0);
 421:../Algorithms/src/doppler.c **** 		p_temp[1] = (uint16_t *)get_buffer_address_by_chirp(p_acq_buf, 1, 0);
 422:../Algorithms/src/doppler.c **** 	}
 423:../Algorithms/src/doppler.c **** 	else
 424:../Algorithms/src/doppler.c **** 	{
 425:../Algorithms/src/doppler.c **** 		/* Only one chirp for Doppler */
 426:../Algorithms/src/doppler.c **** 		p_temp[0] = (uint16_t *)get_buffer_address_by_chirp(p_acq_buf, 2, 0);
 427:../Algorithms/src/doppler.c **** 		p_temp[1] = (uint16_t *)get_buffer_address_by_chirp(p_acq_buf, 3, 0);
 428:../Algorithms/src/doppler.c **** 	}
 429:../Algorithms/src/doppler.c **** 
 430:../Algorithms/src/doppler.c **** 	for (uint32_t i = 0; i < Ns; i++)
 431:../Algorithms/src/doppler.c **** 	{
 432:../Algorithms/src/doppler.c **** 		raw_data_i1[i] = (float)((p_temp[0])[i]) * if_scale;
 433:../Algorithms/src/doppler.c **** 		raw_data_q1[i] = (float)((p_temp[1])[i]) * if_scale;
 434:../Algorithms/src/doppler.c **** 	}
 435:../Algorithms/src/doppler.c **** 
 436:../Algorithms/src/doppler.c **** 	doppler_calc_speed(fft_fast_time_window, raw_data_i1, raw_data_q1, Ns, cp_algo_settings, cp_dev_se
 437:../Algorithms/src/doppler.c **** 
 438:../Algorithms/src/doppler.c **** 	/* indicated, that the results are taken from dedicated frame */
 439:../Algorithms/src/doppler.c **** 	p_algo_result->frame_counter = p_acq_buf->frame_counter;
 440:../Algorithms/src/doppler.c **** }
